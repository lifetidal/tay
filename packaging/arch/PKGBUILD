# Local source snapshot, generated by tools/package-arch.sh.
pkgname=tay
pkgver=0.1.0
pkgrel=5
pkgdesc='Wayland dropdown terminal with Lua configuration'
arch=('x86_64' 'aarch64')
license=('GPL-3.0-only')
depends=('glibc' 'gcc-libs' 'wayland' 'libxkbcommon' 'fontconfig')
makedepends=('cargo' 'pkgconf')
optdepends=(
    'vulkan-icd-loader: Vulkan rendering backend (requires a GPU driver)'
    'mesa: OpenGL rendering backend'
    'xdg-desktop-portal: global shortcut integration'
    'xdg-desktop-portal-kde: global shortcut backend on KDE Plasma'
    'ttf-jetbrains-mono-nerd: font used by the desktop configuration example'
)
conflicts=('tay-git')
source=('tay-source.tar.gz')
sha256sums=('SKIP') # Replaced with the snapshot digest by the wrapper.

build() {
    cd "$srcdir/tay"
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
    cargo build --release --locked --bin tay --bin tayd
}

check() {
    cd "$srcdir/tay"
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
    cargo test --locked --workspace
}

package() {
    cd "$srcdir/tay"
    local target_dir="${CARGO_TARGET_DIR:-$srcdir/target}"
    install -Dm755 "$target_dir/release/tay" "$pkgdir/usr/bin/tay"
    install -Dm755 "$target_dir/release/tayd" "$pkgdir/usr/bin/tayd"
    install -Dm644 packaging/tay.desktop "$pkgdir/usr/share/applications/tay.desktop"
    install -Dm644 packaging/tayd.service "$pkgdir/usr/lib/systemd/user/tayd.service"
    install -Dm644 config/desktop.lua "$pkgdir/usr/share/doc/tay/examples/config.lua"
    install -Dm644 README.md "$pkgdir/usr/share/doc/tay/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/tay/LICENSE"
}
